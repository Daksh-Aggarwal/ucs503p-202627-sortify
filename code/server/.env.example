MODEL_PATH=models/best.pt
MODEL_CONFIDENCE=0.25
MODEL_IOU=0.45
# Comma-separated origins in production. * is convenient for Expo development.
CORS_ORIGINS=*
# Only set when MODEL_PATH is a model pickle you trust completely.
ALLOW_PICKLE=false
# Keep this false for the trained 10-class Sortify checkpoint. It only enables
# conservative aliases for a standard COCO yolo11s.pt demo checkpoint.
ALLOW_COCO_FALLBACK=false
